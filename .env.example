# Copy this file to .env, then fill in the values. .env is in .gitignore:
# it must never be committed, and a key that was pushed once must be revoked.
#
#   cp .env.example .env
#   nano .env
#
# Load it in a shell before running the pipeline:
#
#   set -a; source .env; set +a
#
# The variables must be in the environment of the process that runs the tasks:
# exporting them after `airflow standalone` has started changes nothing for it.

# ---- the LLM that writes the bulletin -------------------------------------
# "openai" calls a provider over the OpenAI-compatible route, "fake" runs
# offline with no key and marks its output as model-free.
LLM_BACKEND=openai

# Groq: https://api.groq.com/openai/v1    Mistral: https://api.mistral.ai/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# The exact model name, copied from your provider's console. List what your key
# can reach:  curl -s $LLM_BASE_URL/models -H "Authorization: Bearer $LLM_API_KEY" | jq -r '.data[].id' | sort
LLM_MODEL=

# Your key. Treat it like a password: never commit it, never print it.
LLM_API_KEY=

# Optional, with their defaults:
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=3000          a reasoning model spends part of this budget thinking
# LLM_TIMEOUT=120
# LLM_REASONING_EFFORT=low     Groq gpt-oss: low | medium | high
# LLM_INCLUDE_REASONING=false  drop the reasoning from the answer

# ---- where the pipeline writes -------------------------------------------
# Defaults to app/data when unset; the server will point somewhere else.
# BULLETIN_DATA_DIR=

# ---- Airflow (local development) -----------------------------------------
# AIRFLOW_HOME=/home/anais/WorkProject/Airflow/app/airflow_home
# AIRFLOW__CORE__DAGS_FOLDER=/home/anais/WorkProject/Airflow/app/dags
